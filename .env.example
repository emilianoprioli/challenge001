COMPUTE_ENVIRONMENT=local
COMPUTE_HOST=0.0.0.0
COMPUTE_PORT=8000
COMPUTE_LOG_LEVEL=INFO
COMPUTE_DATABASE_URL=postgresql+psycopg://compute:compute@postgres:5432/compute
COMPUTE_PROVIDER_URL=http://127.0.0.1:8001
COMPUTE_PROVIDER_MAX_CONCURRENCY=5
COMPUTE_PROVIDER_MAX_QUEUE_SIZE=20
COMPUTE_PROVIDER_PROCESSING_MS=250
# Railway control plane (opcional; usar un project token de solo alcance del entorno)
COMPUTE_RAILWAY_PROJECT_TOKEN=
COMPUTE_RAILWAY_ENVIRONMENT_ID=
COMPUTE_RAILWAY_METRICS_CACHE_SECONDS=10
COMPUTE_PROVIDER_TIMEOUT_SECONDS=3
COMPUTE_WORKER_POLL_SECONDS=30
COMPUTE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

